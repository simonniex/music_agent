sdk.dir=C:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk

# DeepSeek / OpenAI-compatible config.
# Copy this file to local.properties and fill real values locally.
DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_BASE_URL=https://tokenhub.tencentmaas.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
VITA_MODEL=youtu-vita

# Tencent Cloud ASR config.
TENCENT_SECRET_ID=replace_with_your_secret_id
TENCENT_SECRET_KEY=replace_with_your_secret_key
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_ASR_ENGINE=16k_zh
